{
	"name": "modelo-site",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "tsx src/core/build/sync.ts && astro build",
		"preview": "astro preview",
		"check": "astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"ci": "biome ci . && astro check && vitest run",
		"build:local": "astro build",
		"test:e2e": "playwright test --trace off",
		"core:update": "git fetch modelo main && git restore --source=modelo/main --staged --worktree src/core && git status --short src/core"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@tailwindcss/vite": "4.3.5",
		"astro": "7.4.11",
		"marked": "18.2.0",
		"sharp": "0.35.5",
		"tailwindcss": "4.3.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.7",
		"@playwright/test": "1.65.0",
		"tsx": "4.23.15",
		"typescript": "5.9.3",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@10.28.0"
}
