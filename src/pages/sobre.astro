---
import site from "../../site.config";
import Seo from "../core/components/Seo.astro";
import { breadcrumb, graph, orgRef } from "../core/schema";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<Seo
		slot="head"
		title={`Sobre — ${site.name}`}
		description="Quem somos e como trabalhamos: uma equipa pequena de consultores de gestão ao lado das PME."
		jsonLd={graph(
			{ "@type": "AboutPage", url: new URL("/sobre/", site.url).href, about: orgRef },
			breadcrumb([
				["Início", "/"],
				["Sobre", "/sobre/"],
			]),
		)}
	/>

	<main>
		<section class="page-hero">
			<div class="container">
				<nav class="breadcrumb" aria-label="Breadcrumb">
					<a href="/">Início</a><span class="breadcrumb-sep">/</span><span>Sobre</span>
				</nav>
				<h1>Sobre nós</h1>
				<p class="lead">Uma equipa pequena que prefere poucas mudanças bem feitas a muitos relatórios na gaveta.</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<article class="article">
					<h2>Como trabalhamos</h2>
					<p>Começamos sempre por ouvir quem faz o trabalho todos os dias. Depois propomos poucas mudanças, por ordem de impacto, e ficamos até elas funcionarem.</p>
					<h2>O que nos distingue</h2>
					<ul>
						<li>Planos curtos, com datas e responsáveis.</li>
						<li>Indicadores simples, revistos todos os meses.</li>
						<li>Preço fechado em cada fase do projeto.</li>
					</ul>
				</article>
			</div>
		</section>
	</main>
</BaseLayout>
