---
import { render } from "astro:content";
import site from "../../../site.config";
import Article from "../../components/Article.astro";
import { getPosts } from "../../core/blog";
import Seo from "../../core/components/Seo.astro";
import { abs, breadcrumb, graph, orgRef } from "../../core/schema";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	return (await getPosts()).map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { data } = post;
const canonical = data.canonical ?? abs(`/blog/${post.id}/`);
const image = abs(data.image?.src ?? site.org.ogImage);
const published = data.pubDate.toISOString();
const modified = data.updatedDate?.toISOString();
---

<BaseLayout>
	<Seo
		slot="head"
		title={`${data.title} — ${site.name}`}
		description={data.description}
		canonical={canonical}
		ogType="article"
		ogImage={image}
		ogImageAlt={data.image?.alt ?? data.title}
		articlePublishedTime={published}
		articleModifiedTime={modified}
		articleAuthor={data.author}
		jsonLd={graph(
			{
				"@type": "Article",
				"@id": `${canonical}#article`,
				headline: data.title,
				description: data.description,
				datePublished: published,
				...(modified ? { dateModified: modified } : {}),
				inLanguage: site.lang,
				author: { "@type": "Person", name: data.author },
				publisher: orgRef,
				mainEntityOfPage: canonical,
				image,
			},
			breadcrumb([
				["Início", "/"],
				["Artigos", "/blog/"],
				[data.title, `/blog/${post.id}/`],
			]),
		)}
	/>

	<Article
		title={data.title}
		description={data.description}
		pubDate={data.pubDate}
		updatedDate={data.updatedDate}
		author={data.author}
	>
		<Content />
	</Article>
</BaseLayout>
