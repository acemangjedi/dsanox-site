---
import Projeto from "../../../paginas/Projeto.astro";
import { projetosDe } from "../../../projetos";

export async function getStaticPaths() {
	return (await projetosDe("fr")).map((p) => ({
		params: { slug: p.data.slug },
	}));
}
const { slug } = Astro.params;
---

<Projeto lang="fr" slug={slug} />
