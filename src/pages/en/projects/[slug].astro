---
import Projeto from "../../../paginas/Projeto.astro";
import { projetosDe } from "../../../projetos";

export async function getStaticPaths() {
	return (await projetosDe("en")).map((p) => ({
		params: { slug: p.slug },
	}));
}
const { slug } = Astro.params;
---

<Projeto lang="en" slug={slug} />
