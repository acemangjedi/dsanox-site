---
// Direção C, "Relatório".
import { Image } from "astro:assets";
import f01 from "../../assets/fotos/foto-01.jpg";
import f07 from "../../assets/fotos/foto-07.jpg";
import f12 from "../../assets/fotos/foto-12.jpg";
import logo from "../../assets/logo-escuro.png";
import Figure from "../../core/blocks/Figure.astro";
import Layout from "../../layouts/Direcao.astro";
import css from "../../styles/direcao-c.css?url";
import t from "../../textos/pt";
---

<Layout css={css} fonts={["archivo-600", "source-serif-400"]} theme="#ffffff">
<header class="cabecalho">
	<div class="limite">
		<a href="#conteudo" aria-label="DS Anox, início"><Image src={logo} alt="" width={143} loading="eager" /></a>
		<nav aria-label="Principal" class="sans">
			{t.nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<a class="botao" href="#contactos">{t.hero.primary}</a>
	</div>
</header>

<main id="conteudo">
	<section class="limite heroi">
		<div>
			<span class="regua" aria-hidden="true"></span>
			<h1>{t.hero.title}</h1>
			<p class="mt-8 max-w-[34rem] text-ink-2">{t.hero.lede}</p>
			<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
				<a class="botao" href="#contactos">{t.hero.primary}</a>
				<a class="ligacao-forte" href="#servicos">{t.hero.secondary}</a>
			</div>
		</div>
		<Figure src={f01} alt={t.alts.skid} caption={t.alts.skid} priority widths={[480, 800, 1086]} sizes="(min-width: 1024px) 34rem, 100vw" />
	</section>

	<div class="lema">
		<p class="limite">{t.motto.join(" ")}</p>
	</div>

	<section class="limite seccao" id="servicos">
		<h2>{t.services.title}</h2>
		<div class="texto">
			<p>{t.services.intro}</p>
			<ul class="areas mt-10">
				{t.services.areas.map((a) => (
					<li>
						<h3>{a.name}</h3>
						<p class="mt-3 text-ink-2">{a.text}</p>
						<ul>{a.items.map((item) => <li>{item}</li>)}</ul>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="limite larga">
		<Figure src={f07} alt={t.alts.pipes} caption={t.alts.pipes} widths={[640, 1200]} sizes="(min-width: 1216px) 70rem, 100vw" />
	</div>

	<section class="limite seccao" id="processo">
		<h2>{t.process.title}</h2>
		<ol class="passos texto">
			{t.process.steps.map((s) => (
				<li>
					<div>
						<h3>{s.name}</h3>
						<p class="mt-2 text-ink-2">{s.text}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section class="limite pb-20 md:pb-28" id="equipa">
		<div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-20">
			<Figure src={f12} alt={t.alts.outside} widths={[480, 800]} sizes="(min-width: 1024px) 22rem, 100vw" />
			<div class="lg:self-end">
				<h2 class="text-[1.875rem] md:text-[2.375rem]">{t.team.title}</h2>
				<p class="mt-6 max-w-[40rem]">{t.team.intro}</p>
				<ul class="oficios mt-10">
					{t.team.roles.map((r) => (
						<li>
							<h3>{r.name}</h3>
							<p class="mt-2 text-[1rem] leading-[1.6] text-ink-2">{r.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<section class="contacto" id="contactos">
		<div class="limite py-20 md:py-28">
			<span class="regua" aria-hidden="true"></span>
			<h2 class="max-w-[18ch]">{t.contact.title}</h2>
			<p class="mt-6 max-w-[34rem] text-ink-2">{t.contact.text}</p>
			<dl class="max-w-[44rem]">
				<div><dt>{t.contact.labels.phone}</dt><dd><a href={`tel:${t.contact.phone.replaceAll(" ", "")}`}>{t.contact.phone}</a></dd></div>
				<div><dt>{t.contact.labels.email}</dt><dd><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></dd></div>
				<div class="sm:col-span-2"><dt>{t.contact.labels.address}</dt><dd>{t.contact.address.join(", ")}</dd></div>
			</dl>
		</div>
	</section>
</main>

<footer class="rodape">
	<div class="limite">
		<p>DS Anox · Metalurgia de alta precisão</p>
		<p>Louro, Vila Nova de Famalicão</p>
	</div>
</footer>
</Layout>
