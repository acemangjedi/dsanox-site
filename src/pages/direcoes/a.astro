---
// Direção A, "Folha de obra".
import { Image } from "astro:assets";
import f01 from "../../assets/fotos/foto-01.jpg";
import f03 from "../../assets/fotos/foto-03.jpg";
import f04 from "../../assets/fotos/foto-04.jpg";
import f06 from "../../assets/fotos/foto-06.jpg";
import f09 from "../../assets/fotos/foto-09.jpg";
import logo from "../../assets/logo-escuro.png";
import Figure from "../../core/blocks/Figure.astro";
import Layout from "../../layouts/Direcao.astro";
import css from "../../styles/direcao-a.css?url";
import t from "../../textos/pt";

const n = (i: number) => String(i + 1).padStart(2, "0");
---

<Layout css={css} fonts={["big-shoulders-800", "plex-sans-400", "plex-mono-500"]} theme="#e9ebed">
<div class="folha">
	<header class="cabecalho">
		<a class="marca" href="#conteudo" aria-label="DS Anox, início">
			<Image src={logo} alt="" width={132} loading="eager" />
		</a>
		<p class="mono !hidden sm:!flex">Louro · Vila Nova de Famalicão</p>
		<nav aria-label="Principal" class="mono">
			{t.nav.map((l) => <a href={l.href}>{l.label}</a>)}
		</nav>
		<a class="botao botao-cheio !border-0 !px-5" href="#contactos">{t.hero.primary}</a>
	</header>

	<main id="conteudo">
		<section class="heroi">
			<div class="texto !justify-end">
				<div>
					<h1>{t.hero.title}</h1>
					<p class="mt-8 max-w-[52ch] text-[1.1875rem] text-ink-2">{t.hero.lede}</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a class="botao botao-cheio" href="#contactos">{t.hero.primary}</a>
						<a class="botao botao-linha" href="#servicos">{t.hero.secondary}</a>
					</div>
				</div>
			</div>
			<div class="imagem">
				<Figure src={f03} alt={t.hero.alt} priority widths={[480, 800, 1086]} sizes="(min-width: 1024px) 30rem, 100vw" />
				<p class="cota mt-4">{t.hero.kicker}</p>
			</div>
		</section>

		<div class="lema">
			{t.motto.map((line) => <p>{line}</p>)}
		</div>

		<section class="seccao" id="servicos">
			<div class="margem"><span class="num" aria-hidden="true">01</span><span class="mono">Serviços</span></div>
			<div class="corpo">
				<h2>{t.services.title}</h2>
				<p class="mt-6 max-w-[58ch] text-ink-2">{t.services.intro}</p>
				<ul class="areas">
					{t.services.areas.map((a, i) => (
						<li>
							<span class="mono text-ink-2">{`1.${i + 1}`}</span>
							<h3>{a.name}</h3>
							<p class="mt-3 text-ink-2">{a.text}</p>
							<ul>{a.items.map((item) => <li>{item}</li>)}</ul>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="seccao" id="processo">
			<div class="margem"><span class="num" aria-hidden="true">02</span><span class="mono">Método</span></div>
			<div class="corpo">
				<h2>{t.process.title}</h2>
				<ol class="passos">
					{t.process.steps.map((s, i) => (
						<li>
							<span class="mono text-accent">{n(i)}</span>
							<h3>{s.name}</h3>
							<p class="mt-3 text-[0.9375rem] text-ink-2">{s.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<div class="tira">
			<Figure src={f04} alt={t.alts.pipes} widths={[400, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
			<Figure src={f06} alt={t.alts.weld} widths={[400, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
			<Figure src={f09} alt={t.alts.outside} widths={[400, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
			<Figure src={f01} alt={t.alts.skid} widths={[400, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
		</div>

		<section class="seccao" id="equipa">
			<div class="margem"><span class="num" aria-hidden="true">03</span><span class="mono">Equipa</span></div>
			<div class="corpo">
				<h2>{t.team.title}</h2>
				<p class="mt-6 max-w-[58ch] text-ink-2">{t.team.intro}</p>
				<ul class="oficios">
					{t.team.roles.map((r, i) => (
						<li>
							<span class="mono text-accent">{`3.${i + 1}`}</span>
							<h3>{r.name}</h3>
							<p class="text-ink-2">{r.text}</p>
						</li>
					))}
				</ul>
			</div>
		</section>

		<section class="seccao" id="contactos">
			<div class="margem"><span class="num" aria-hidden="true">04</span><span class="mono">Contactos</span></div>
			<div class="corpo">
				<h2 class="!max-w-[20ch]">{t.contact.title}</h2>
				<p class="mt-6 max-w-[58ch] text-ink-2">{t.contact.text}</p>
				<dl class="dados">
					<div><dt class="mono text-ink-2">{t.contact.labels.phone}</dt><dd><a href={`tel:${t.contact.phone.replaceAll(" ", "")}`}>{t.contact.phone}</a></dd></div>
					<div><dt class="mono text-ink-2">{t.contact.labels.email}</dt><dd><a href={`mailto:${t.contact.email}`}>{t.contact.email}</a></dd></div>
					<div><dt class="mono text-ink-2">{t.contact.labels.address}</dt><dd>{t.contact.address.map((l) => <span class="block">{l}</span>)}</dd></div>
				</dl>
			</div>
		</section>
	</main>

	<footer class="rodape mono">
		<p>DS Anox</p>
		<p>Metalurgia de alta precisão</p>
		<p class="md:text-right">Folha 01 de 05 · Início</p>
	</footer>
</div>
</Layout>
