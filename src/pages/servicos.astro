---
import site from "../../site.config";
import CtaBanner from "../components/CtaBanner.astro";
import Seo from "../core/components/Seo.astro";
import { breadcrumb, graph, orgRef } from "../core/schema";
import BaseLayout from "../layouts/BaseLayout.astro";

const services = [
	{
		name: "Diagnóstico de gestão",
		text: "Duas semanas para perceber onde a empresa perde tempo e dinheiro. No fim recebe um relatório com as cinco mudanças que mais contam.",
	},
	{
		name: "Organização de processos",
		text: "Desenhamos com a equipa os processos principais, do pedido do cliente à fatura, e acompanhamos a mudança.",
	},
	{
		name: "Controlo financeiro",
		text: "Orçamento anual, previsão de tesouraria e um painel mensal com os números que importam.",
	},
	{
		name: "Equipas e liderança",
		text: "Funções, objetivos e rotinas de acompanhamento para que cada pessoa saiba o que se espera dela.",
	},
];
---

<BaseLayout>
	<Seo
		slot="head"
		title={`Serviços — ${site.name}`}
		description="Diagnóstico de gestão, organização de processos, controlo financeiro e equipas para pequenas e médias empresas."
		jsonLd={graph(
			...services.map((s) => ({
				"@type": "Service",
				name: s.name,
				description: s.text,
				provider: orgRef,
				areaServed: "PT",
			})),
			breadcrumb([
				["Início", "/"],
				["Serviços", "/servicos/"],
			]),
		)}
	/>

	<main>
		<section class="page-hero">
			<div class="container">
				<nav class="breadcrumb" aria-label="Breadcrumb">
					<a href="/">Início</a><span class="breadcrumb-sep">/</span><span>Serviços</span>
				</nav>
				<h1>Serviços</h1>
				<p class="lead">Cada projeto começa por um diagnóstico curto e segue com um plano que a equipa consegue cumprir.</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="grid grid-2">
					{services.map((s) => (
						<div class="card reveal">
							<h2 class="h3">{s.name}</h2>
							<p class="text-muted">{s.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class="section-tight">
			<div class="container">
				<CtaBanner
					title="Não sabe por onde começar?"
					text="Comece pelo diagnóstico: em duas semanas sabe o que mudar primeiro."
					primaryHref="/contactos/"
					primaryLabel="Pedir proposta"
					secondaryHref="/sobre/"
					secondaryLabel="Conhecer a equipa"
				/>
			</div>
		</section>
	</main>
</BaseLayout>
