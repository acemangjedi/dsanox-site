---
// Phase 0 proof: the demo home rebuilt with Tailwind 4 and the core Tabs block.
import site from "../../site.config";
import Tabs from "../core/blocks/Tabs.astro";
import Seo from "../core/components/Seo.astro";
import ProvaTailwind from "../layouts/ProvaTailwind.astro";

const services = [
	{
		title: "Processos",
		text: "Mapeamos como o trabalho circula na empresa e tiramos os passos que não acrescentam valor.",
	},
	{
		title: "Finanças",
		text: "Orçamento, tesouraria e indicadores mensais que se leem em cinco minutos.",
	},
	{
		title: "Equipas",
		text: "Funções claras, reuniões curtas e objetivos que todos conhecem.",
	},
];
const faq = [
	{
		q: "Trabalham com empresas de que dimensão?",
		a: "Sobretudo com empresas de 5 a 100 pessoas, em qualquer setor.",
	},
	{
		q: "Quanto tempo dura um projeto?",
		a: "Um diagnóstico demora duas semanas. Um projeto completo, entre dois e seis meses.",
	},
	{
		q: "Fazem reuniões à distância?",
		a: "Sim. A maior parte do acompanhamento é feita por videochamada, com visitas quando fazem falta.",
	},
];
const wrap = "mx-auto max-w-6xl px-6";
const btn =
	"inline-flex items-center whitespace-nowrap rounded-full px-6 py-3 font-semibold";
---

<ProvaTailwind>
	<Seo slot="head" title={`${site.name} — Prova Tailwind`} description={site.org.description} />

	<header class="border-b border-line">
		<nav class={`${wrap} flex h-18 items-center justify-between`} aria-label="Menu principal">
			<a href="/" class="font-display text-xl font-extrabold md:text-2xl">{site.name}</a>
			<ul class="hidden gap-8 text-ink-2 md:flex">
				<li><a href="/servicos/" class="hover:text-ink">Serviços</a></li>
				<li><a href="/sobre/" class="hover:text-ink">Sobre</a></li>
				<li><a href="/contactos/" class="hover:text-ink">Contactos</a></li>
			</ul>
			<a href="/contactos/" class={`${btn} bg-accent text-accent-ink`}>Pedir proposta</a>
		</nav>
	</header>

	<main id="main" tabindex="-1">
		<section class={`${wrap} py-24 md:py-32`}>
			<h1 class="max-w-3xl font-display text-5xl leading-[1.05] font-extrabold md:text-7xl">Empresas mais simples de gerir.</h1>
			<p class="mt-6 max-w-2xl text-lg text-ink-2 md:text-xl">Ajudamos pequenas e médias empresas a organizar processos, finanças e equipas, com planos curtos e resultados que se medem.</p>
			<div class="mt-10 flex flex-wrap gap-4">
				<a href="/contactos/" class={`${btn} bg-accent text-accent-ink`}>Pedir proposta</a>
				<a href="/servicos/" class={`${btn} border border-line`}>Ver serviços</a>
			</div>
		</section>

		<section class="bg-surface py-24">
			<div class={wrap}>
				<h2 class="font-display text-4xl font-extrabold">Três áreas, um só plano</h2>
				<div class="mt-12 grid gap-6 md:grid-cols-3">
					{services.map((s) => (
						<div class="rounded-2xl border border-line p-8">
							<h3 class="font-display text-2xl font-extrabold">{s.title}</h3>
							<p class="mt-3 text-ink-2">{s.text}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<section class={`${wrap} py-24`}>
			<h2 class="font-display text-4xl font-extrabold">Como trabalhamos</h2>
			<Tabs id="como" labels={["Diagnóstico", "Plano", "Acompanhamento"]} class="mt-10 max-w-3xl">
				<p slot="0">Duas semanas de entrevistas e números, com as cinco mudanças que mais contam.</p>
				<p slot="1">Um plano curto, com responsáveis e datas, que cabe numa página.</p>
				<p slot="2">Uma reunião por mês para medir o que mudou e corrigir o rumo.</p>
			</Tabs>
		</section>

		<section class={`${wrap} pb-24`}>
			<h2 class="font-display text-4xl font-extrabold">Perguntas frequentes</h2>
			<div class="mt-10 max-w-3xl divide-y divide-line border-y border-line">
				{faq.map(({ q, a }) => (
					<details class="group py-5">
						<summary class="flex cursor-pointer list-none justify-between gap-4 text-lg font-semibold">{q}<span aria-hidden="true" class="group-open:rotate-45">+</span></summary>
						<p class="mt-3 text-ink-2">{a}</p>
					</details>
				))}
			</div>
		</section>
	</main>

	<footer class="border-t border-line py-10 text-sm text-muted">
		<div class={`${wrap} flex flex-wrap justify-between gap-4`}>
			<p>© {new Date().getFullYear()} {site.name}</p>
			<ul class="flex gap-6">
				<li><a href="/politica-de-privacidade/" class="hover:text-ink">Privacidade</a></li>
				<li><a href="/termos-e-condicoes/" class="hover:text-ink">Termos</a></li>
			</ul>
		</div>
	</footer>
</ProvaTailwind>
