---
import site from "../../site.config";
import LeadForm from "../core/components/LeadForm.astro";
import Seo from "../core/components/Seo.astro";
import { breadcrumb, graph, orgRef } from "../core/schema";
import BaseLayout from "../layouts/BaseLayout.astro";

const { email, phone } = site.contacts;
const address = site.org.address;
---

<BaseLayout>
	<Seo
		slot="head"
		title={`Contactos — ${site.name}`}
		description="Fale connosco por email, telefone ou formulário. Respondemos no próprio dia útil."
		jsonLd={graph(
			{ "@type": "ContactPage", url: new URL("/contactos/", site.url).href, mainEntity: orgRef },
			breadcrumb([
				["Início", "/"],
				["Contactos", "/contactos/"],
			]),
		)}
	/>

	<main>
		<section class="page-hero">
			<div class="container">
				<nav class="breadcrumb" aria-label="Breadcrumb">
					<a href="/">Início</a><span class="breadcrumb-sep">/</span><span>Contactos</span>
				</nav>
				<h1>Contactos</h1>
				<p class="lead">Conte-nos o que precisa. Respondemos no próprio dia útil.</p>
			</div>
		</section>

		<section class="section">
			<div class="container">
				<div class="two-col top">
					<div class="contact-info">
						<div class="contact-row">
							<div>
								<div class="contact-label">Email</div>
								<div class="contact-value"><a href={`mailto:${email}`}>{email}</a></div>
							</div>
						</div>
						{phone && (
							<div class="contact-row">
								<div>
									<div class="contact-label">Telefone</div>
									<div class="contact-value"><a href={`tel:${phone}`}>{phone}</a></div>
								</div>
							</div>
						)}
						{address && (
							<div class="contact-row">
								<div>
									<div class="contact-label">Morada</div>
									<div class="contact-value">{address.street}<br />{address.postalCode} {address.locality}</div>
								</div>
							</div>
						)}
					</div>
					<div class="card">
						<h2 class="h3">Envie-nos uma mensagem</h2>
						<LeadForm form="contactos" />
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
