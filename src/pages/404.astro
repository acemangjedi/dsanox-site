---
import site from "../../site.config";
import Seo from "../core/components/Seo.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout variant="minimal">
	<Seo slot="head" title={`Página não encontrada — ${site.name}`} description="A página que procura não existe ou foi movida." robots="noindex, follow" />
	<main>
		<section class="section">
			<div class="container text-center">
				<h1>Esta página não existe.</h1>
				<p class="lead">Pode ter sido movida ou o link está errado.</p>
				<div class="hero-actions">
					<a href="/" class="btn btn-accent btn-lg">Voltar ao início</a>
					<a href="/contactos/" class="btn btn-outline btn-lg">Contactos</a>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
