---
import site from "../../../site.config";
import { langOf, pathOf, t } from "../i18n";

interface Props {
	// Name of the form in site.config.ts (forms), e.g. "contactos".
	form: string;
	submitLabel?: string;
}
const lang = langOf(Astro.url.pathname, site);
const w = t(lang);
const { form, submitLabel = w.send } = Astro.props;
const key = site.forms[form];
if (!key) throw new Error(`site.config.ts has no form named "${form}"`);
const action = `${site.panel.url}/api/v1/forms/${key}`;
const consentText = w.consent;
const { email, phone, whatsapp } = site.contacts;
---

<!-- Without JavaScript the panel answers with a redirect to /obrigado/. -->
<form class="form lead-form" method="post" action={action} data-lead-form data-thanks={pathOf("thanks", lang, site)} data-error={w.formError}>
	<div class="form-group">
		<label for={`${form}-name`}>{w.name} <span class="req">*</span></label>
		<input id={`${form}-name`} name="name" autocomplete="name" required maxlength="200" />
	</div>
	<div class="form-row">
		<div class="form-group">
			<label for={`${form}-email`}>{w.email} <span class="req">*</span></label>
			<input id={`${form}-email`} name="email" type="email" autocomplete="email" required maxlength="254" />
		</div>
		<div class="form-group">
			<label for={`${form}-phone`}>{w.phone}</label>
			<input id={`${form}-phone`} name="phone" type="tel" autocomplete="tel" maxlength="50" />
		</div>
	</div>
	<slot />
	<div class="form-group">
		<label for={`${form}-message`}>{w.message} <span class="req">*</span></label>
		<textarea id={`${form}-message`} name="message" required maxlength="5000"></textarea>
	</div>
	<label class="form-checkbox">
		<input type="checkbox" name="consent" value="on" required />
		<span>{w.consentBefore} <a href={pathOf("privacy", lang, site)}>{w.privacyLink}</a>.</span>
	</label>
	<input type="hidden" name="consent_text" value={consentText} />
	<input type="hidden" name="form_ts" value="" />
	<div class="lead-form-trap" aria-hidden="true">
		<label>{w.trap} <input name="website" tabindex="-1" autocomplete="off" /></label>
	</div>
	<p class="lead-form-error" role="alert" hidden></p>
	<div class="lead-form-fallback" role="alert" hidden>
		<p>{w.formFallback}</p>
		<ul>
			<li><a href={`mailto:${email}`}>{email}</a></li>
			{phone && <li><a href={`tel:${phone}`}>{phone}</a></li>}
			{whatsapp && <li><a href={`https://wa.me/${whatsapp}`} rel="noopener noreferrer" target="_blank">WhatsApp</a></li>}
		</ul>
	</div>
	<button type="submit" class="btn btn-accent btn-lg">{submitLabel}</button>
</form>

<script src="../scripts/lead-form.js"></script>

<style>
	.lead-form-trap {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}
	.lead-form-error {
		color: var(--error);
	}
	.lead-form-fallback {
		border: 1px solid var(--border-strong);
		border-radius: var(--r-sm);
		padding: var(--s-4);
		margin-bottom: var(--s-4);
	}
</style>
