---
import { Image } from "astro:assets";
// An image with fixed dimensions (no layout shift), resized by Astro, with an optional
// caption and credit. alt is required: pass alt="" only for a decorative image.
import type { ImageMetadata } from "astro";

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	// Photographer or source, with an optional link (e.g. the photo's page on Unsplash).
	credit?: string;
	creditUrl?: string;
	widths?: number[];
	sizes?: string;
	// The first image people see on the page: load it at once.
	priority?: boolean;
	class?: string;
}
const {
	src,
	alt,
	caption,
	credit,
	creditUrl,
	widths = [480, 800, 1200, 1600],
	sizes = "100vw",
	priority = false,
	class: className,
} = Astro.props;
---

<figure class:list={["figure", className]}>
	<Image
		src={src}
		alt={alt}
		widths={widths.filter((w) => w <= src.width)}
		sizes={sizes}
		format="webp"
		loading={priority ? "eager" : "lazy"}
		fetchpriority={priority ? "high" : "auto"}
	/>
	{(caption || credit) && (
		<figcaption>
			{caption}
			{credit && (
				<span class="figure-credit">
					{creditUrl ? <a href={creditUrl} rel="noopener">{credit}</a> : credit}
				</span>
			)}
		</figcaption>
	)}
</figure>
