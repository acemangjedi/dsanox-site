---
// Slider: a list that scrolls sideways (touch, trackpad, keyboard) with previous and
// next buttons. It never moves on its own. The core sets only what makes it scroll;
// the site styles .slider, .slider-track > li and .slider-controls button.
//
// <Slider label="Obras recentes"><li>…</li><li>…</li></Slider>
import site from "../../../site.config";
import { langOf, t } from "../i18n";

interface Props {
	label: string;
	class?: string;
}
const { label, class: className } = Astro.props;
const w = t(langOf(Astro.url.pathname, site));
---

<section class:list={["slider", className]} aria-label={label} data-slider>
	<ul class="slider-track" tabindex="0">
		<slot />
	</ul>
	<div class="slider-controls">
		<button type="button" data-slider-prev>{w.previous}</button>
		<button type="button" data-slider-next>{w.next}</button>
	</div>
</section>

<style is:global>
	.slider-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.slider-track > li {
		flex: 0 0 auto;
		scroll-snap-align: start;
	}
	@media (prefers-reduced-motion: no-preference) {
		.slider-track {
			scroll-behavior: smooth;
		}
	}
</style>

<script>
	for (const slider of document.querySelectorAll<HTMLElement>("[data-slider]")) {
		const track = slider.querySelector<HTMLElement>(".slider-track");
		const prev = slider.querySelector<HTMLButtonElement>("[data-slider-prev]");
		const next = slider.querySelector<HTMLButtonElement>("[data-slider-next]");
		if (!track || !prev || !next) continue;
		const step = () =>
			(track.firstElementChild as HTMLElement | null)?.offsetWidth ??
			track.clientWidth;
		const update = () => {
			prev.disabled = track.scrollLeft <= 1;
			next.disabled =
				track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
		};
		prev.addEventListener("click", () =>
			track.scrollBy({ left: -step() }),
		);
		next.addEventListener("click", () => track.scrollBy({ left: step() }));
		track.addEventListener("scroll", update, { passive: true });
		update();
	}
</script>
