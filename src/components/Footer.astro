---
import site from "../../site.config";

interface Props {
	variant?: "full" | "minimal";
}
const { variant = "full" } = Astro.props;
const year = new Date().getFullYear();
const { email, phone } = site.contacts;
const address = site.org.address;
const legalLinks = [
	{ href: "/politica-de-privacidade/", label: "Privacidade" },
	{ href: "/politica-de-cookies/", label: "Cookies" },
	{ href: "/termos-e-condicoes/", label: "Termos" },
];
---

<footer class="footer">
	<div class="container">
		{variant === "full" && (
			<div class="footer-top">
				<div>
					<a href="/" class="brand">
						<span class="brand-name">Horizonte<span class="brand-accent">.</span></span>
					</a>
					<p class="footer-tagline">{site.org.description}</p>
				</div>
				<div>
					<div class="footer-col-title">Empresa</div>
					<ul class="footer-links">
						<li><a href="/servicos/">Serviços</a></li>
						<li><a href="/sobre/">Sobre</a></li>
						{site.blog && <li><a href="/blog/">Artigos</a></li>}
						<li><a href="/contactos/">Contactos</a></li>
					</ul>
				</div>
				<div>
					<div class="footer-col-title">Contacto</div>
					<ul class="footer-links">
						<li><a href={`mailto:${email}`}>{email}</a></li>
						{phone && <li><a href={`tel:${phone}`}>{phone}</a></li>}
						{address && <li>{address.street}<br />{address.postalCode} {address.locality}</li>}
					</ul>
				</div>
			</div>
		)}
		<div class="footer-bottom">
			<div>© {year} {site.name} · Todos os direitos reservados</div>
			<div class="footer-bottom-links">
				{legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
				<a href="https://www.livroreclamacoes.pt/Inicio/" target="_blank" rel="noopener noreferrer">Livro de Reclamações</a>
				<button type="button" class="cookie-settings-btn">Definições de cookies</button>
			</div>
		</div>
	</div>
</footer>

<style>
	.cookie-settings-btn {
		background: none;
		border: none;
		padding: 0;
		font: inherit;
		color: inherit;
		cursor: pointer;
	}
	.cookie-settings-btn:hover {
		text-decoration: underline;
	}
</style>
