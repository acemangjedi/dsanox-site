---
interface FaqItem {
	q: string;
	a: string;
}

interface Props {
	items: FaqItem[];
	title: string;
	eyebrow?: string;
	introText?: string;
	ctaHref?: string;
	ctaLabel?: string;
	ctaBtnClass?: string;
	sectionId?: string;
}

const {
	items,
	title,
	eyebrow,
	introText,
	ctaHref,
	ctaLabel = "Falar connosco",
	ctaBtnClass = "btn btn-outline",
	sectionId,
} = Astro.props;

const split = !!ctaHref;
---

<section class="section" id={sectionId}>
  <div class="container">
    {split ? (
      <div class="two-col two-col--faq">
        <div class="reveal">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h2 class="section-title">{title}</h2>
          {introText && <p class="section-intro mb-6">{introText}</p>}
          <a href={ctaHref} target="_blank" rel="noopener noreferrer" class={ctaBtnClass}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.2-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.4-1.5-.9-.8-1.5-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.1-.3-.2-.6-.3z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 5L2 22l5.2-1.4c1.4.8 3.1 1.3 4.8 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.5 0-3-.4-4.3-1.2l-.3-.2-3.2.8.9-3.1-.2-.3C4.4 14.7 4 13.4 4 12c0-4.4 3.6-8 8-8s8 3.6 8 8-3.6 8-8 8z"/></svg>
            {ctaLabel}
          </a>
        </div>
        <div class="faq-list reveal">
          {items.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q} <span class="faq-toggle">+</span></summary>
              <div class="faq-answer"><div>{a}</div></div>
            </details>
          ))}
        </div>
      </div>
    ) : (
      <>
        <div class="section-header reveal">
          <div>
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <h2 class="section-title">{title}</h2>
          </div>
        </div>
        <div class="faq-list reveal" style="max-width: 820px;">
          {items.map(({ q, a }) => (
            <details class="faq-item">
              <summary>{q} <span class="faq-toggle">+</span></summary>
              <div class="faq-answer"><div>{a}</div></div>
            </details>
          ))}
        </div>
      </>
    )}
  </div>
</section>
