---
import site from "../../site.config";
import Brand from "./Brand.astro";

interface Props {
	variant?: "full" | "minimal";
}
const { variant = "full" } = Astro.props;
const links = [
	{ href: "/servicos/", label: "Serviços" },
	{ href: "/sobre/", label: "Sobre" },
	...(site.blog ? [{ href: "/blog/", label: "Artigos" }] : []),
	{ href: "/contactos/", label: "Contactos" },
];
---

{variant === "full" ? (
	<>
		<header class="header">
			<div class="container header-inner">
				<Brand />
				<nav class="nav" aria-label="Menu principal">
					<ul class="nav-list">
						{links.map((l) => <li><a href={l.href} class="nav-link">{l.label}</a></li>)}
					</ul>
					<div class="nav-cta-group">
						<a href="/contactos/" class="btn btn-accent">Pedir proposta</a>
					</div>
					<button type="button" class="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
						<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
					</button>
				</nav>
			</div>
		</header>
		<div class="mobile-menu" id="mobile-menu" aria-hidden="true" inert>
			<a href="/">Início</a>
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
			<div class="mobile-cta">
				<a href="/contactos/" class="btn btn-accent">Pedir proposta</a>
			</div>
		</div>
	</>
) : (
	<header class="header">
		<div class="container header-inner">
			<Brand />
			<nav class="nav" aria-label="Menu principal">
				<a href="/" class="btn btn-outline">Página inicial</a>
			</nav>
		</div>
	</header>
)}
