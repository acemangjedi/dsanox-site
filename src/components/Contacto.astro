---
import LeadForm from "../core/components/LeadForm.astro";
import type { Lang } from "../core/i18n";
import { textosDe } from "../textos";
// The red band that closes a page: the invitation, the contacts and the form.
import Curva from "./Curva.astro";

interface Props {
	lang: Lang;
	// On the contact page this is the page's title.
	principal?: boolean;
}
const { lang, principal = false } = Astro.props;
const t = textosDe(lang).contact;
const Titulo = principal ? "h1" : "h2";
const Subtitulo = principal ? "h2" : "h3";
const mapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(t.address.join(", "))}`;
---

<section class="contacto" id="contacto">
	<Curva />
	<div class="limite">
		<div>
			<Titulo class="revela">{t.title}</Titulo>
			<p class="mt-8 max-w-[40ch] text-[1.1875rem]">{t.text}</p>
			<dl>
				<div><dt>{t.labels.phone}</dt><dd><a href={`tel:${t.phone.replaceAll(" ", "")}`}>{t.phone}</a></dd></div>
				<div><dt>{t.labels.email}</dt><dd><a href={`mailto:${t.email}`}>{t.email}</a></dd></div>
				<div><dt>{t.labels.address}</dt><dd class="morada">
					{t.address.map((l) => <span>{l}</span>)}
					<a class="mt-2 inline-flex min-h-11 items-center" href={mapa} target="_blank" rel="noopener noreferrer">{t.map}</a>
				</dd></div>
			</dl>
		</div>
		<div class="ficha">
			<Subtitulo class="titulo">{t.formTitle}</Subtitulo>
			<LeadForm form="contactos" submitLabel={t.send} />
		</div>
	</div>
</section>
