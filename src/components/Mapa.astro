---
// The world in dots, with one mark for each place given. The marks come from the
// projects, so the map follows them. A place with a name and an address is a link:
// the name shows when the pointer is on the mark. The marks are for the pointer
// only: the same links are in the list under the map, for keyboard and readers.
import { land, STEP, TOP } from "../dados/mundo";

interface Props {
	label: string;
	places: { lat: number; lng: number; name?: string; href?: string }[];
}
const { label, places } = Astro.props;
// The drawing is 148 by 58, starting at -2, -2.
const onde = (p: { lat: number; lng: number }) =>
	`left:${(((p.lng + 180) / STEP + 2) / 148) * 100}%;top:${(((TOP - p.lat) / STEP + 2) / 58) * 100}%`;
---

<div class="mapa">
	<svg viewBox="-2 -2 148 58" role="img" aria-label={label}>
		<path class="terra" d={land} />
	</svg>
	{places.map((p) =>
		p.href ? (
			<a class="marca" href={p.href} tabindex="-1" aria-hidden="true" style={onde(p)}>
				<span class="nome">{p.name}</span>
			</a>
		) : (
			<span class="marca" style={onde(p)} />
		),
	)}
</div>
