---
import site from "../../site.config";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Analytics from "../core/components/Analytics.astro";
import CookieBanner from "../core/components/CookieBanner.astro";
import cssUrl from "../styles/style.css?url";

interface Props {
	variant?: "full" | "minimal";
}
const { variant = "full" } = Astro.props;
---

<!DOCTYPE html>
<html lang={site.lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07111f">
<slot name="head" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="stylesheet" href={cssUrl}>
<link rel="preload" as="font" href="/fonts/barlow-800.woff2" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="/fonts/ibm-plex-sans-400.woff2" type="font/woff2" crossorigin>
<Analytics />
</head>
<body>
<a href="#main-content" class="skip-to-content">Saltar para o conteúdo principal</a>
<Header variant={variant} />
<div id="main-content" tabindex="-1">
<slot />
</div>
<Footer variant={variant} />
<CookieBanner />
<script src="../scripts/main.js"></script>
</body>
</html>
