---
// Layout of the three design directions (/direcoes/a|b|c/), until one is chosen.
import Seo from "../core/components/Seo.astro";
import t from "../textos/pt";

interface Props {
	css: string;
	fonts: string[];
	theme: string;
}
const { css, fonts, theme } = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content={theme}>
<Seo title={t.seo.title} description={t.seo.description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href={css}>
{fonts.map((f) => <link rel="preload" as="font" href={`/fonts/${f}.woff2`} type="font/woff2" crossorigin>)}
</head>
<body>
<a href="#conteudo" class="saltar">Saltar para o conteúdo principal</a>
<slot />
</body>
</html>
