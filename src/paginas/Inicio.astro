---
import f01 from "../assets/fotos/foto-01.jpg";
import f02 from "../assets/fotos/foto-02.jpg";
import f08 from "../assets/fotos/foto-08.jpg";
import f09 from "../assets/fotos/foto-09.jpg";
import f12 from "../assets/fotos/foto-12.jpg";
import f11 from "../assets/fotos/topo/foto-11.jpg";
import Contacto from "../components/Contacto.astro";
import Mapa from "../components/Mapa.astro";
import Figure from "../core/blocks/Figure.astro";
import type { Lang } from "../core/i18n";
import Layout from "../layouts/Site.astro";
import { projetosDe } from "../projetos";
import { textosDe } from "../textos";
import { areas, rotas } from "../textos/rotas";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = textosDe(lang);
const projetos = await projetosDe(lang);
const n = (i: number) => String(i + 1).padStart(2, "0");
const areaPhotos = [
	{ src: f02, alt: t.alts.plant },
	{ src: f01, alt: t.alts.skid },
	{ src: f09, alt: t.alts.outside },
];
---

<Layout lang={lang} title={t.seo.home.title} description={t.seo.home.description} pagina="home" sobreposto>
	<section class="heroi">
		<div class="fundo">
			<Figure class="h-full" src={f11} alt={t.alts.plant} priority widths={[480, 800, 1200, 2000]} sizes="100vw" />
		</div>
		<svg class="arco" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
			<path d="M -2 38 C 18 90, 62 96, 102 58" />
		</svg>
		<div class="limite">
			<h1>{t.hero.lines.map((l) => <span class="linha">{l} </span>)}</h1>
			<div class="mt-8 flex flex-col gap-8 md:mt-10 md:flex-row md:items-end md:justify-between">
				<p class="lede">{t.hero.lede}</p>
				<div class="flex flex-wrap gap-3">
					<a class="botao botao-cheio" href="#contacto">{t.hero.primary}</a>
					<a class="botao botao-linha" href={rotas.services[lang]}>{t.hero.secondary}</a>
				</div>
			</div>
		</div>
	</section>

	<div class="lema overflow-hidden">
		<div class="limite">
			{t.motto.map((line) => <p>{line}</p>)}
		</div>
	</div>

	<section class="seccao">
		<div class="limite">
			<div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
				<h2 class="revela">{t.services.title}</h2>
				<div>
					<p class="max-w-[48ch] text-ink-2">{t.services.intro}</p>
					<a class="ligacao mt-5" href={rotas.services[lang]}>{t.services.more}</a>
				</div>
			</div>
			<ul class="areas">
				{t.services.areas.map((a, i) => (
					<li class="revela">
						<Figure src={areaPhotos[i].src} alt={areaPhotos[i].alt} widths={[480, 800, 1086]} sizes="(min-width: 1024px) 45vw, 100vw" />
						<div>
							<span class="num" aria-hidden="true">{n(i)}</span>
							<h3>{a.name}</h3>
							<p class="mt-5 max-w-[44ch] text-ink-2">{a.text}</p>
							<ul>{a.items.map((item) => <li>{item}</li>)}</ul>
							<a class="ligacao mt-6" href={rotas[areas[i]][lang]}>{t.servicesPage.see}</a>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<div class="faixa">
		<Figure src={f12} alt={t.alts.tank} widths={[640, 1200, 1800]} sizes="100vw" />
	</div>

	<section class="seccao">
		<div class="limite">
			<h2 class="revela">{t.process.title}</h2>
			<ol class="passos">
				{t.process.steps.map((s, i) => (
					<li class="revela">
						<span class="num" aria-hidden="true">{n(i)}</span>
						<h3>{s.name}</h3>
						<p>{s.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	{projetos.length > 0 && (
	<section class="seccao onde">
			<div class="limite">
				<div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
					<h2 class="revela">{t.projects.homeTitle}</h2>
					<div>
						<p class="max-w-[48ch] text-ink-2">{t.projects.homeText}</p>
						<a class="ligacao mt-5" href={rotas.projects[lang]}>{t.projects.all}</a>
					</div>
				</div>
				<Mapa label={t.projects.map} places={projetos.flatMap((p) => p.coords ?? [])} />
				<ol class="locais">
					{projetos.map((p) => (
						<li>
							<a href={p.href}>
								<span class="lugar">{p.place ?? p.title}</span>
								<span class="pais">{p.country}</span>
								{p.place && <span class="obra">{p.title}</span>}
							</a>
						</li>
					))}
				</ol>
			</div>
		</section>
	)}

	<section class="seccao bg-steel">
		<div class="limite equipa">
			<Figure class="revela" src={f08} alt={t.alts.close} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 45vw, 100vw" />
			<div>
				<h2 class="revela medio">{t.team.title}</h2>
				<p class="mt-6 max-w-[44ch] text-ink-2">{t.team.intro}</p>
				<ul class="oficios mt-8 border-t border-line">
					{t.team.roles.map((r) => (
						<li class="revela">
							<h3>{r.name}</h3>
							<p class="mt-2 text-[1.0625rem] text-ink-2">{r.text}</p>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>

	<Contacto lang={lang} />
</Layout>
