---
// A page with one message and the way back: thank you, and page not found.
import type { Lang } from "../core/i18n";
import Layout from "../layouts/Site.astro";
import { textosDe } from "../textos";
import { rotas } from "../textos/rotas";

interface Props {
	lang: Lang;
	aviso: "thanks" | "notFound";
}
const { lang, aviso } = Astro.props;
const todos = textosDe(lang);
const t = todos[aviso];
const tel = todos.contact.phone;
---

<Layout lang={lang} title={t.seoTitle} description={t.text} pagina={aviso === "thanks" ? "thanks" : undefined} robots="noindex, follow">
	<section class="topo aviso">
		<div class="limite">
			<h1>{t.title}</h1>
			<p>{t.text}</p>
			{aviso === "thanks" && <p>{todos.thanks.call} <a class="ligacao" href={`tel:${tel.replaceAll(" ", "")}`}>{tel}</a>.</p>}
			<div class="mt-10 flex flex-wrap gap-3">
				<a class="botao botao-cheio" href={rotas.home[lang]}>{t.back}</a>
				<a class="botao botao-linha" href={rotas.services[lang]}>{todos.hero.secondary}</a>
			</div>
		</div>
	</section>
</Layout>
