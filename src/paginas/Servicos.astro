---
import f06 from "../assets/fotos/foto-06.jpg";
import f07 from "../assets/fotos/foto-07.jpg";
import f10 from "../assets/fotos/foto-10.jpg";
import f04 from "../assets/fotos/topo/foto-04.jpg";
import Chamada from "../components/Chamada.astro";
import Topo from "../components/Topo.astro";
import Figure from "../core/blocks/Figure.astro";
import type { Lang } from "../core/i18n";
import Layout from "../layouts/Site.astro";
import { textosDe } from "../textos";
import { areas, rotas } from "../textos/rotas";

interface Props {
	lang: Lang;
}
const { lang } = Astro.props;
const t = textosDe(lang);
const n = (i: number) => String(i + 1).padStart(2, "0");
const photos = [
	{ src: f07, alt: t.alts.hall },
	{ src: f06, alt: t.alts.weld },
	{ src: f10, alt: t.alts.lift },
];
---

<Layout lang={lang} title={t.seo.services.title} description={t.seo.services.description} pagina="services" sobreposto>
	<Topo src={f04} alt={t.alts.pipes} title={t.servicesPage.title} text={t.services.intro} />

	{t.services.areas.map((a, i) => (
		<section class="area">
			<div class="limite">
				<div class="cabeca">
					<span class="num" aria-hidden="true">{n(i)}</span>
					<h2 class="revela">{a.name}</h2>
					<p>{a.text}</p>
					<a class="ligacao lg:col-start-2" href={rotas[areas[i]][lang]}>{t.servicesPage.see}</a>
				</div>
				<div class:list={["corpo", { inverso: i % 2 === 1 }]}>
					<Figure class="revela" src={photos[i].src} alt={photos[i].alt} widths={[480, 800, 1086]} sizes="(min-width: 1024px) 40vw, 100vw" />
					<ul class="itens">
						{a.items.map((item) => <li class="revela">{item}</li>)}
					</ul>
				</div>
			</div>
		</section>
	))}

	<Chamada lang={lang} />
</Layout>
