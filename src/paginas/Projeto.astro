---
// One project: what was done, where, and its photographs.
import { render } from "astro:content";
import Chamada from "../components/Chamada.astro";
import Mapa from "../components/Mapa.astro";
import Figure from "../core/blocks/Figure.astro";
import type { Lang } from "../core/i18n";
import Layout from "../layouts/Site.astro";
import { projetosDe, versoesDe } from "../projetos";
import { textosDe } from "../textos";
import { areas, rotas } from "../textos/rotas";

interface Props {
	lang: Lang;
	slug: string;
}
const { lang, slug } = Astro.props;
const t = textosDe(lang);
const projetos = await projetosDe(lang);
const i = projetos.findIndex((p) => p.slug === slug);
const d = projetos[i];
const seguinte = projetos[(i + 1) % projetos.length];
const { Content } = await render(d.entry);
const local = [d.place, d.country].filter(Boolean).join(", ");
const fotos = d.carousel && d.cover ? [d.cover, ...d.gallery] : [];
---

<Layout lang={lang} title={`${[d.title, d.place].filter(Boolean).join(", ")} | DS Anox`} description={d.description} alternates={await versoesDe(d.key)}>
	<section class="topo sem-linha">
		<div class="limite">
			<a class="ligacao" href={rotas.projects[lang]}>{t.projects.back}</a>
			<h1 class="mt-6 longo">{d.title}</h1>
			<p>{d.description}</p>
		</div>
	</section>
	{fotos.length > 1 ? (
		<ul class="carrossel" tabindex="0" aria-label={t.projects.photos}>
			{fotos.map((f, j) => (
				<li><Figure src={f.src} alt={f.alt} priority={j === 0} widths={[560, 900, 1400]} sizes="(max-width: 768px) 75vw, 62vw" /></li>
			))}
		</ul>
	) : d.cover && (
		<div class="limite">
			<Figure class="capa" src={d.cover.src} alt={d.cover.alt} priority widths={[560, 900, 1400, 1800]} sizes="(max-width: 768px) 75vw, (min-width: 1440px) 1360px, 100vw" />
		</div>
	)}
	<section class="seccao">
		<div class="limite projeto">
			<div>
				<dl>
					{local && (
						<div>
							<dt>{t.projects.labels.place}</dt>
							<dd>{local}</dd>
						</div>
					)}
					{d.year && (
						<div>
							<dt>{t.projects.labels.year}</dt>
							<dd>{d.year}</dd>
						</div>
					)}
					{d.area !== undefined && (
						<div>
							<dt>{t.projects.labels.area}</dt>
							<dd><a href={rotas[areas[d.area]][lang]}>{t.services.areas[d.area].name}</a></dd>
						</div>
					)}
				</dl>
				{d.coords && <Mapa label={local || d.title} places={[d.coords]} />}
				{d.demo && <p class="nota">{t.projects.demoNote}</p>}
			</div>
			<div class="prosa">
				<Content />
			</div>
		</div>
	</section>
	<section class="pb-20 md:pb-32">
		<div class="limite">
			{fotos.length < 2 && d.gallery.length > 0 && (
				<>
					<h2 class="sr-only">{t.projects.photos}</h2>
					<ul class="galeria">
						{d.gallery.map((g) => (
							<li class="revela"><Figure src={g.src} alt={g.alt} widths={[480, 800, 1100]} sizes="(min-width: 768px) 48vw, 100vw" /></li>
						))}
					</ul>
				</>
			)}
			{projetos.length > 1 && (
				<ul class="outras md:mt-20">
					<li><a href={seguinte.href}><span class="rotulo">{t.projects.next}</span>{seguinte.title}</a></li>
				</ul>
			)}
		</div>
	</section>
	<Chamada lang={lang} />
</Layout>
